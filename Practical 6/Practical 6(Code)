from pgmpy.models import DiscreteBayesianNetwork
from pgmpy.factors.discrete import TabularCPD
from pgmpy.inference import VariableElimination
# ---------------------------------------------------------
# Step 1: Define Network Structure
# Relationships: Flu -> Fever, Covid -> Fever, Fever -> Fatigue, Fever -> Cough
# ---------------------------------------------------------
model = DiscreteBayesianNetwork([
    ("Flu", "Fever"),
    ("Covid", "Fever"),
    ("Fever", "Fatigue"),
    ("Fever", "Cough")
])
# ---------------------------------------------------------
# Step 2: Define Conditional Probability Distributions (CPDs)
# ---------------------------------------------------------
# P(Flu): 10% chance a person has the flu
cpd_flu = TabularCPD(
    variable="Flu",
    variable_card=2,
    values=[[0.90], [0.10]],  # [P(False), P(True)]
    state_names={"Flu": ["False", "True"]}
)
# P(Covid): 5% chance a person has Covid-19
cpd_covid = TabularCPD(
    variable="Covid",
    variable_card=2,
    values=[[0.95], [0.05]],  # [P(False), P(True)]
    state_names={"Covid": ["False", "True"]}
)
# P(Fever | Flu, Covid): Probability of fever based on underlying conditions
# Columns represent combinations: (Flu=F, Covid=F), (Flu=F, Covid=T), (Flu=T, Covid=F), (Flu=T, Covid=T)
cpd_fever = TabularCPD(
    variable="Fever",
    variable_card=2,
    values=[
        [0.98, 0.20, 0.15, 0.02],  # Fever = False
        [0.02, 0.80, 0.85, 0.98]   # Fever = True
    ],
    evidence=["Flu", "Covid"],
    evidence_card=[2, 2],
    state_names={
        "Fever": ["False", "True"],
        "Flu": ["False", "True"],
        "Covid": ["False", "True"]
    }
)
# P(Fatigue | Fever)
cpd_fatigue = TabularCPD(
    variable="Fatigue",
    variable_card=2,
    values=[
        [0.90, 0.15],  # Fatigue = False
        [0.10, 0.85]   # Fatigue = True
    ],
    evidence=["Fever"],
    evidence_card=[2],
    state_names={
        "Fatigue": ["False", "True"],
        "Fever": ["False", "True"]
    }
)
# P(Cough | Fever)
cpd_cough = TabularCPD(
    variable="Cough",
    variable_card=2,
    values=[
        [0.85, 0.25],  # Cough = False
        [0.15, 0.75]   # Cough = True
    ],
    evidence=["Fever"],
    evidence_card=[2],
    state_names={
        "Cough": ["False", "True"],
        "Fever": ["False", "True"]
    }
)
# ---------------------------------------------------------
# Step 3: Attach CPDs to Network & Validate
# ---------------------------------------------------------
model.add_cpds(cpd_flu, cpd_covid, cpd_fever, cpd_fatigue, cpd_cough)
print("Is Bayesian Network valid?", model.check_model())
# ---------------------------------------------------------
# Step 4: Perform Inference
# ---------------------------------------------------------
inference = VariableElimination(model)
# Query: What is the probability of having Covid if the patient has Fatigue and Cough?
result = inference.query(
    variables=["Covid"],
    evidence={
        "Fatigue": "True",
        "Cough": "True"
    }
)
print("\nProbability of Covid given Fatigue=True and Cough=True:")
print(result)
