table = {
    ('Yes', 'Yes', 'No'): 'Accept Order',
    ('Yes', 'No', 'No'): 'Wait for Restaurant',
    ('Yes', 'Yes', 'Yes'): 'Deliver Order',
    ('No', 'Yes', 'No'): 'Wait for Order',
